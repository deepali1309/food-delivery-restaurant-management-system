# ==============================================================================
# BiteBuddy Environment Variables Template
# Copy this file to .env and adjust variables for your local development setup.
# IMPORTANT: NEVER commit actual secrets, API keys, or database credentials to Git!
# ==============================================================================

# Node / Express Backend API Port & Host
PORT=5000
NODE_ENV=development

# Frontend API Base URL (Used by assets/js/services/api.service.js)
API_BASE_URL=http://localhost:5000/api

# MongoDB Atlas Connection URI (For future backend integration)
# Replace <username>, <password>, and <cluster-url> with your Atlas cluster details
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bitebuddy?retryWrites=true&w=majority

# JWT Authentication Secret Key (For backend token generation)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,https://food-delivery-restaurant-management.vercel.app

